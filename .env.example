SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-public-key-here
# Optional: backup for admin image uploads (images normally go to the Supabase `videos` bucket)
IMGBB_API_KEY=
APP_URL=https://your-service.onrender.com
WHATSAPP_NUMBER=9665XXXXXXXX
ALLOWED_ORIGINS=https://your-service.onrender.com,https://yourdomain.com
BRANCH_NAME=Red House Trading
DELIVERY_FEE=0
# Optional: admin "Auto-translate" button (English -> Arabic + Chinese). Server-side only, never put it in frontend code.
GEMINI_API_KEY=
# Optional: Gemini model name (default gemini-flash-lite-latest)
GEMINI_MODEL=
# Moyasar payment keys. Use pk_test_/sk_test_ while testing, then switch to pk_live_/sk_live_.
# The publishable key is sent to the browser; the secret key must remain server-side.
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
# Optional: maps (admin pin picker + delivery route on the tracking page). All free by default, nothing needs setting.
# Map pictures: any raster tile URL with {z}/{x}/{y} (default: OpenStreetMap, fine for light use; use a free-tier tile
# provider if traffic grows) and the credit line it requires.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
# Road routes: base URL of an OSRM-compatible server (default: the free public demo server).
ROUTING_URL=
# Sent to OpenStreetMap's address search so they can contact you if needed (default is built from APP_URL).
GEOCODER_USER_AGENT=
